  <header><div class="logo"><i></i><i></i><i></i></div><div class="ttl"><b>ScratchMind</b><small>tell me what to build</small></div>
    <button class="hb go" data-a="run" title="Green flag">▶</button><button class="hb st" data-a="stop" title="Stop">■</button>
    <button class="hb" data-a="min" title="Minimise">–</button><button class="hb" data-a="close" title="Close">✕</button></header>
  <div class="log" aria-live="polite"></div>
  <div class="chips"></div>
  <div class="bar"><textarea placeholder="e.g. make a flappy bird game" rows="1"></textarea><button class="send" title="Send">➤</button></div>
</div>

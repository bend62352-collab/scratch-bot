.hb{border:0;background:#3b2d63;color:#fff;border-radius:9px;min-width:32px;height:30px;font-size:14px;cursor:pointer;padding:0 8px}
.hb:hover{background:#5a47a0}.hb.go{background:#59c059;color:#102a10}.hb.go:hover{background:#6fd96f}.hb.st{background:#ff6680;color:#3a0010}
.log{flex:1;overflow:auto;padding:16px 14px 8px;display:flex;flex-direction:column;gap:12px;scroll-behavior:smooth}
.m{max-width:88%;padding:10px 13px;font-size:14px;line-height:1.45;word-wrap:break-word;white-space:pre-wrap}
.m.bot{align-self:flex-start;background:#fff;border:2px solid #2a1f45;border-radius:4px 16px 16px 16px;position:relative;margin-top:6px}
.m.bot:before{content:"";position:absolute;left:12px;top:-8px;width:16px;height:6px;background:#fff;border:2px solid #2a1f45;border-bottom:0;border-radius:4px 4px 0 0}
.m.me{align-self:flex-end;background:#7b4fd6;color:#fff;border-radius:16px 16px 4px 16px}
.m code{background:#ece8fb;border-radius:5px;padding:0 4px;font-family:Consolas,monospace;font-size:12.5px}
.m b{font-weight:800}.m.stat{align-self:center;background:none;color:#7a6aa8;font-size:12.5px;padding:0}
.dots span{display:inline-block;width:7px;height:7px;margin:0 2px;border-radius:50%;background:#7b4fd6;animation:b 1s infinite}
.dots span:nth-child(2){animation-delay:.15s}.dots span:nth-child(3){animation-delay:.3s}
@keyframes b{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-5px);opacity:1}}
@media (prefers-reduced-motion:reduce){.dots span{animation:none}.log{scroll-behavior:auto}}
.chips{display:flex;gap:6px;padding:4px 12px 8px;overflow-x:auto;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;border:2px solid #2a1f45;background:#fff;color:#2a1f45;border-radius:999px;padding:4px 11px;font-size:12.5px;font-weight:700;cursor:pointer}
.chip:hover{background:#ffab19}
.bar{display:flex;gap:8px;padding:10px 12px 12px;border-top:2px solid #2a1f45;background:#fff}
textarea{flex:1;resize:none;height:44px;border:2px solid #2a1f45;border-radius:12px;padding:10px 12px;font-size:14px;color:#2a1f45;background:#f3f5ff;outline:none}
textarea:focus{border-color:#7b4fd6;background:#fff}
.send{width:48px;border:0;border-radius:12px;background:#ffab19;color:#2a1f45;font-weight:900;font-size:18px;cursor:pointer;box-shadow:0 3px 0 #b87400}
.send:active{transform:translateY(2px);box-shadow:0 1px 0 #b87400}.send:disabled{opacity:.5;cursor:default}
.hb:focus-visible,.chip:focus-visible,.send:focus-visible{outline:3px solid #7b4fd6;outline-offset:2px}
.fab{display:none;width:58px;height:58px;border-radius:18px;border:0;background:#2a1f45;cursor:pointer;box-shadow:4px 4px 0 #ffab19;align-items:center;justify-content:center}
.fab.on{display:flex}.fab .logo{transform:scale(.9)}
</style>

  const menu = p.menu, lv = p.level || 2;
  const go = () => menu ? onMsg('start') : flag();
  const setLv = L => [set('botSpeed', L.bot), set('botZone', L.zone), set('baseSpeed', L.ball)];
  const btn = (i, y) => ({ key: 'Lvl' + LV[i].n, kind: 'button', label: LV[i].n, color: LV[i].c, size: 140, x: 0, y, scripts: [

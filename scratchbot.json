const INTENTS = {
  catch: ['catch', 'fall(ing)?', 'basket', 'collect', 'apples?', 'coins?'], pong: ['pong', 'paddles?', 'table tennis'],
  flappy: ['flappy', 'flap', 'pipes?', 'tappy'], shooter: ['shoot(er|ing)?', 'invaders?', 'asteroids?', 'space ?ship', 'space (game|shooter)', 'galaga', 'blaster', 'aliens?'],
  runner: ['dino', 'runner', 'endless', 'cactus', 'obstacles?', 'jump over', 'chrome'], clicker: ['clicker', 'cookies?', 'idle', 'tycoon', 'upgrades?', 'incremental'],
  survive: ['survive', 'chase', 'chaser', 'dodge', 'avoid', 'escape', 'run away', 'tag'],
  quiz: ['quiz', 'trivia', 'math', 'multiplication', 'times tables?', 'addition', 'subtraction', 'flash ?cards?'],
  dash: ['geometry dash', 'geometry', 'dash', 'gd', 'rhythm', 'spikes?', 'cube'],
  chatbot: ['chat ?bot', 'talk to me', 'conversation', 'greeter', 'ai friend', 'virtual friend']
};
function pickTemplate(s) {
  let best = null, bs = 0;
  for (const [id, ws] of Object.entries(INTENTS)) {
    const sc = ws.reduce((a, w) => a + (new RegExp('\\b' + w + '\\b').test(s) ? 1 : 0), 0);
    if (sc > bs) { bs = sc; best = id; }
  }
  return best;
}

/* ══════════════════════════════════════════════════════════════════
   6. BEHAVIOUR SNIPPETS  (add logic to the sprite you have selected)
   ══════════════════════════════════════════════════════════════════ */
function snippets(text, p, gy) {
  const s = p.s, scripts = [], vars = [], did = [];
  const sp = Math.round(5 * p.speed);
  const take = (re, fn, label) => { const m = s.match(re); if (m) { fn(m); did.push(label); } };
  take(/\b(move|walk|control|steer)\b.*\b(arrow|arrows|wasd|keys?|keyboard)\b|\b(arrow keys?|wasd)\b/, () => {
    scripts.push([flag(), forever(
      iff(or(keyDown('right arrow'), keyDown('d')), chX(sp)), iff(or(keyDown('left arrow'), keyDown('a')), chX(-sp)),
      iff(or(keyDown('up arrow'), keyDown('w')), chY(sp)), iff(or(keyDown('down arrow'), keyDown('s')), chY(-sp)))]);
  }, 'moves with the arrow keys / WASD');
  take(/follow\w*.*\b(mouse|cursor|pointer)\b/, () => scripts.push([flag(), forever(goTo('_mouse_'))]), 'follows the mouse');
  take(/\b(bounce|bouncing|dvd)\b/, () => scripts.push([flag(), point(rnd(30, 150)), forever(move(sp + 1), bounce())]), 'bounces around the stage');
  take(/\b(spin|spinning|rotate|twirl)\b/, () => scripts.push([flag(), forever(turnR(5))]), 'spins');
  take(/\b(jump|jumps|jumping)\b/, () => { vars.push('vy'); scripts.push([flag(), set('vy', 0),
    forever(chg('vy', -1), chY(V('vy')), iff(lt(ypos(), gy), setY(gy), set('vy', 0), iff(keyDown('space'), set('vy', 13))))]); }, 'jumps with SPACE');
  take(/\b(glide|wander|roam|float around|drift)\b/, () => scripts.push([flag(), forever(n('motion_glidesecstoxy', { SECS: 1, X: rnd(-200, 200), Y: rnd(-150, 150) }))]), 'glides around randomly');
  take(/\b(animate|animation|walk cycle|flip costumes?)\b/, () => scripts.push([flag(), forever(nextCostume(), wait(0.15))]), 'animates through its costumes');
  take(/\b(grow|bigger|get big)\b/, () => scripts.push([onClick(), chSize(10)]), 'grows when clicked');
  take(/\b(shrink|smaller)\b/, () => scripts.push([onClick(), chSize(-10)]), 'shrinks when clicked');
  take(/\b(color|colour)\b.*\b(click|touch|press)|\b(click|touch|press)\b.*\b(color|colour)/, () => scripts.push([onClick(), effect('COLOR', 25)]), 'changes colour when clicked');
  take(/\b(disappear|vanish|hide)\b.*\b(click|touch)|\b(click|touch).*\b(disappear|vanish|hide)\b/, () => scripts.push([onClick(), hide()]), 'hides when clicked');
  take(/\b(add|make|create|keep|count)\b.*\b(score|points)\b/, () => { vars.push('score'); scripts.push([flag(), set('score', 0), showVar('score')], [onClick(), chg('score', 1)]); }, 'has a score (+1 per click)');
  take(/\b(timer|stopwatch|clock)\b/, () => scripts.push([flag(), resetTimer(), forever(say(round(timer())))]), 'shows a timer');
  const sayM = text.match(/\bsay(?:s)?\s+["“']?([^"”']{1,60}?)["”']?(?:\s+(?:when|if|on|after)\b.*)?$/i);
  if (sayM) {
    const msg = sayM[1].trim();
    scripts.push(/\b(click|touch)/.test(s) ? [onClick(), say(msg, 2)] : [flag(), say(msg, 2)]);
    did.push(`says "${msg}"`);
  }
  return scripts.length ? { title: 'Sprite behaviour', current: scripts, vars, did } : null;
}

/* ══════════════════════════════════════════════════════════════════
   7. BUILDER  (talks to the real Scratch VM)
   ══════════════════════════════════════════════════════════════════ */
const BLANK = 'cd21514d0531fdffb22204e0ec5ed84a';
const undoStack = [];
const OWN = (typeof window !== 'undefined') ? (window.__smOwned = window.__smOwned || { sprites: [], vars: [], tops: [] }) : { sprites: [], vars: [], tops: [] };
async function wipe(vm) {
  const rt = vm.runtime, stage = rt.getTargetForStage();
  for (const id of OWN.sprites.splice(0)) { if (rt.getTargetById(id)) { try { vm.deleteSprite(id); } catch (e) {} } }
  for (const id of OWN.tops.splice(0)) { try { stage.blocks.deleteBlock(id); } catch (e) {} }
  for (const id of OWN.vars.splice(0)) {
    try { rt.requestHideMonitor(id); } catch (e) {}
    try { stage.deleteVariable(id); } catch (e) {}
  }
  undoStack.length = 0;
}
async function addSvgCostume(vm, target, name, svg, w, h) {
  const st = vm.runtime.storage;
  const asset = st.createAsset(st.AssetType.ImageVector, 'svg', new TextEncoder().encode(svg), null, true);
  const md5 = asset.assetId + '.svg';
  await vm.addCostume(md5, { name, dataFormat: 'svg', asset, md5, assetId: asset.assetId, bitmapResolution: 1, rotationCenterX: w / 2, rotationCenterY: h / 2 }, target.id);
}
async function makeSprite(vm, sp) {
  const rt = vm.runtime, before = new Set(rt.targets.map(t => t.id));
  const json = { isStage: false, name: sp.key, variables: {}, lists: {}, broadcasts: {}, blocks: {}, comments: {}, currentCostume: 0,
    costumes: [{ assetId: BLANK, name: 'tmp', bitmapResolution: 1, md5ext: BLANK + '.svg', dataFormat: 'svg', rotationCenterX: 0, rotationCenterY: 0 }],
    sounds: [], volume: 100, layerOrder: rt.targets.length + 1, visible: !sp.hidden, x: sp.x || 0, y: sp.y || 0,
    size: sp.size || 100, direction: 90, draggable: false, rotationStyle: sp.rot || 'all around' };
  await vm.addSprite(JSON.stringify(json));
  const t = rt.targets.find(t => !before.has(t.id));
  if (!t) throw new Error('Scratch did not accept the new sprite.');
  const cos = sp.costumes || [{ name: sp.key, kind: sp.kind }];
  for (const c of cos) { const { svg, w, h } = svgOf(c.kind, c.color || sp.color, c.label || sp.label); await addSvgCostume(vm, t, c.name, svg, w, h); }
  t.deleteCostume(0); t.setCostume(0);
  t.setXY(sp.x || 0, sp.y || 0); t.setSize(sp.size || 100); t.setVisible(!sp.hidden);
  try { vm.renameSprite(t.id, sp.key); } catch (e) {}
  return t;
}
async function setBackdrop(vm, bg) {
  const st = vm.runtime.storage, asset = st.createAsset(st.AssetType.ImageVector, 'svg', new TextEncoder().encode(bgSVG(bg)), null, true);
  const md5 = asset.assetId + '.svg', stage = vm.runtime.getTargetForStage();
  await vm.addBackdrop(md5, { name: 'ScratchMind', dataFormat: 'svg', asset, md5, assetId: asset.assetId, bitmapResolution: 1, rotationCenterX: 240, rotationCenterY: 180 });
  const first = stage.getCostumes()[0];
  if (first && first.assetId === BLANK && stage.getCostumes().length > 1) stage.deleteCostume(0);
  for (let i = stage.getCostumes().length - 2; i >= 0; i--) {
    if (stage.getCostumes()[i].name === 'ScratchMind') stage.deleteCostume(i);
  }
}
async function addScripts(vm, t, scripts, env, undo) {
  if (!scripts || !scripts.length) return 0;
  const existing = Object.values(t.blocks._blocks).filter(b => b.topLevel);
  const y0 = existing.length ? Math.max(...existing.map(b => b.y || 0)) + 220 : 20;
  const { blocks, tops } = compile(scripts, env, 30, y0);
  const before = new Set(Object.keys(t.blocks._blocks));
  if (vm.shareBlocksToTarget) await vm.shareBlocksToTarget(blocks, t.id);
  else blocks.forEach(b => t.blocks.createBlock(b));
  const made = Object.keys(t.blocks._blocks).filter(id => !before.has(id) && t.blocks._blocks[id].topLevel);
  undo.tops.push({ t: t.id, ids: made });
  if (t.isStage) OWN.tops.push(...made);
  return tops;
}
async function build(plan) {
  const vm = findVM();
  if (!vm) throw new Error("I can't see the Scratch editor. Open scratch.mit.edu/projects/editor, then paste the script again.");
  const rt = vm.runtime, stage = rt.getTargetForStage();
  const undo = { title: plan.title, sprites: [], tops: [], restore: [], stats: { sprites: 0, scripts: 0 } };
  const env = {
    names: {},
    v: name => {
      const ex = Object.values(stage.variables).find(x => x.name === name && x.type === '');
      if (ex) return ex.id;
      const id = uid(); stage.createVariable(id, name, ''); OWN.vars.push(id); return id;
    },
    bc: name => {
      const ex = Object.values(stage.variables).find(x => x.type === 'broadcast_msg' && x.name.toLowerCase() === name.toLowerCase());
      if (ex) return ex.id;
      const id = uid(); stage.createVariable(id, name, 'broadcast_msg'); return id;
    }
  };
  if (plan.replace) {
    await wipe(vm);
    for (const t of [...rt.targets]) {
      if (!t.isStage && t.isOriginal && t.sprite.name === 'Sprite1' && !Object.keys(t.blocks._blocks).length) {
        try { undo.restore.push(vm.deleteSprite(t.id)); } catch (e) {}
      }
    }
  }
  (plan.vars || []).forEach(env.v);
  const made = [];
  for (const sp of plan.sprites || []) {
    const t = await makeSprite(vm, sp);
    env.names[sp.key] = t.sprite.name; made.push([t, sp]); undo.sprites.push(t.id); OWN.sprites.push(t.id); undo.stats.sprites++;
  }
  if (plan.bg) await setBackdrop(vm, plan.bg);
  for (const [t, sp] of made) undo.stats.scripts += await addScripts(vm, t, sp.scripts, env, undo);
  if (plan.stage && plan.stage.length) undo.stats.scripts += await addScripts(vm, stage, plan.stage, env, undo);
  if (plan.current && plan.current.length) {
    let t = vm.editingTarget;
    if (!t || t.isStage) t = rt.targets.find(x => !x.isStage && x.isOriginal);
    if (!t) throw new Error('There is no sprite to add this to — add a sprite first.');
    undo.stats.scripts += await addScripts(vm, t, plan.current, env, undo);
    vm.setEditingTarget(t.id);
  } else if (made.length) vm.setEditingTarget(made[0][0].id);
  try { (vm.refreshWorkspace || vm.emitWorkspaceUpdate).call(vm); vm.emitTargetsUpdate && vm.emitTargetsUpdate(); } catch (e) {}
  undoStack.push(undo);
  return undo;
}
async function undoLast() {
  const vm = findVM(), u = undoStack.pop();
  if (!vm || !u) return false;
  for (const { t, ids } of u.tops) { const tg = vm.runtime.getTargetById(t); if (tg) ids.forEach(id => { try { tg.blocks.deleteBlock(id); } catch (e) {} }); }
  for (const id of u.sprites) { try { vm.deleteSprite(id); } catch (e) {} }
  for (const r of u.restore) { try { if (typeof r === 'function') await r(); } catch (e) {} }
  try { vm.emitWorkspaceUpdate(); } catch (e) {}
  return u.title;
}

/* ══════════════════════════════════════════════════════════════════
   8. BRAINS:  local rules  +  optional Claude
   ══════════════════════════════════════════════════════════════════ */
const HELP = `I build real Scratch projects: sprites, art, variables and block scripts.\n\n**Full games:** catch game · pong · flappy bird · geometry dash · space shooter · dino runner · cookie clicker · survival chase · math quiz · chatbot\n**Tweak the selected sprite:** "make it move with arrow keys", "follow the mouse", "spin", "bounce around", "jump", "say hi when clicked", "add a score"\n**Customise:** add words like *red*, *night*, *fast*, *easy*, *5 lives*, *multiplication*, *10 questions*\n**Commands:** /run · /stop · /undo · /key sk-ant-… (turn on the Claude brain) · /brain local`;
const OPEN_MSG = `Hi! I'm **ScratchMind**. Tell me what to build — for example *"make a flappy bird game"* or *"make a night space shooter with 5 lives"*. Type **help** to see everything I can do.`;

function localThink(text) {
  const p = parse(text), s = p.s.trim();
  if (/\b(help|what can you|commands?)\b/.test(s) && s.length < 40) return { reply: HELP };
  if (/^(hi|hello|hey|yo|sup)\b/.test(s) && s.length < 20) return { reply: OPEN_MSG };
  const thisSprite = /\b(this|my|current|selected|the) sprite\b|\b(make|let) (it|him|her|them)\b/.test(s);
  const tm = pickTemplate(s);
  if (tm && !thisSprite) return { plan: T[tm](p) };
  const vm = findVM(), et = vm && vm.editingTarget;
  const sn = snippets(text, p, et && !et.isStage ? Math.round(et.y) : -52);
  if (sn) return { plan: sn };
  if (tm) return { plan: T[tm](p) };
  const CLOSE = [[/mario|sonic|platform|parkour|jump/, 'runner', 'a runner (jump over obstacles)'], [/breakout|brick|arkanoid|tennis|badminton/, 'pong', 'pong'],
    [/asteroid|galaga|invader|tank|war|zombie|gun/, 'shooter', 'a space shooter'], [/subway|temple|endless/, 'runner', 'a runner'], [/trivia|exam|test|flashcard/, 'quiz', 'a quiz'],
    [/agar|tag|pac|ghost|maze|escape/, 'survive', 'a survival chase'], [/idle|farm|tycoon|cookie/, 'clicker', 'a clicker'], [/fruit|ninja|pinata|drop/, 'catch', 'a catch game']].find(([re]) => re.test(s));
  if (CLOSE) return { reply: `I can't build that exactly, but the closest thing I can make is **${CLOSE[2]}**. Say *"make ${CLOSE[2].replace(/^an? /, '').replace(/ \(.*\)/, '')}"* and I'll build it — or add **/key sk-ant-…** and Claude will design the real thing.` };
  return { reply: `I'm not sure how to build that yet. Here's what I'm good at:\n\n${HELP}\n\nFor open-ended ideas, give me an API key with **/key sk-ant-…** and I'll use Claude to design the project.` };
}

const LLM_SYSTEM = `You design Scratch 3 projects. Reply with ONLY a JSON object: {"reply":"short friendly explanation","plan":PLAN|null}.
PLAN = {"title":str,"replace":bool,"vars":[names],"bg":{"c1":"#hex","c2":"#hex","stars":0|1,"ground":0|1}|null,"sprites":[SPRITE],"stage":[SCRIPT],"how":"how to play"}
SPRITE = {"key":"UniqueName","kind":one of ball|paddle|basket|apple|star|coin|hero|enemy|alien|ship|bullet|bird|pipe|cactus|cookie|button|banner,"color":"#hex","label":"text for button/banner","x":n,"y":n,"size":percent,"hidden":bool,"scripts":[SCRIPT]}
SCRIPT = array of NODE; the first NODE must be a hat block. NODE = {"op":"scratch_opcode","i":{INPUT:value},"f":{FIELD:value}}.
Input value = number | string | NODE (reporter/boolean) | [NODE,...] (C-block substack: SUBSTACK, SUBSTACK2). Field value = string, or {"var":"name"} for variable fields, or {"bc":"message"} for broadcast fields.
Opcodes: event_whenflagclicked, event_whenkeypressed(f KEY_OPTION e.g. "space","left arrow","a"), event_whenthisspriteclicked, event_whenstageclicked, event_whenbroadcastreceived(f BROADCAST_OPTION {"bc":..}), event_broadcast(i BROADCAST_INPUT "msg"), control_forever, control_repeat(TIMES), control_repeat_until(CONDITION), control_if(CONDITION), control_if_else, control_wait(DURATION), control_create_clone_of(CLONE_OPTION sprite key or "_myself_"), control_start_as_clone, control_delete_this_clone, control_stop(f STOP_OPTION "all"), motion_movesteps(STEPS), motion_turnright(DEGREES), motion_gotoxy(X,Y), motion_goto(TO "_mouse_"/sprite key), motion_changexby(DX), motion_changeyby(DY), motion_setx(X), motion_sety(Y), motion_pointindirection(DIRECTION), motion_pointtowards(TOWARDS), motion_ifonedgebounce, motion_xposition, motion_yposition, motion_direction, looks_say(MESSAGE), looks_sayforsecs(MESSAGE,SECS), looks_show, looks_hide, looks_setsizeto(SIZE), looks_changesizeby(CHANGE), looks_nextcostume, looks_gotofrontback(f FRONT_BACK "front"), sensing_touchingobject(TOUCHINGOBJECTMENU sprite key/"_edge_"/"_mouse_"), sensing_keypressed(KEY_OPTION), sensing_mousex, sensing_mousey, sensing_mousedown, sensing_askandwait(QUESTION), sensing_answer, sensing_timer, sensing_resettimer, operator_add/subtract/multiply/divide(NUM1,NUM2), operator_random(FROM,TO), operator_gt/lt/equals(OPERAND1,OPERAND2), operator_and/or(OPERAND1,OPERAND2), operator_not(OPERAND), operator_join(STRING1,STRING2), operator_round(NUM), data_variable(f VARIABLE {"var":..}), data_setvariableto(VALUE; f VARIABLE), data_changevariableby(VALUE; f VARIABLE), data_showvariable(f VARIABLE).
Rules: Stage is 480x360 (x -240..240, y -180..180). Hide template sprites and spawn clones; a sprite that clones "_myself_" needs a flag script that hides it and a control_start_as_clone script that shows it. Use a "game over" broadcast plus a banner sprite (kind banner, hidden, script [onMsg game over → goto 0,0, front, show, stop all]) for game endings. Put a short wait(0.3) before loops that read variables set by other sprites. Keep it compact but complete and actually playable. If the user is only chatting, set plan to null.`;

let CFG = { key: '', brain: 'local', model: 'claude-sonnet-5-5' };
function cleanNode(nd, depth = 0) {
  if (!nd || typeof nd !== 'object' || depth > 40 || !/^(motion|looks|sound|event|control|sensing|operator|data)_[a-z_]+$/.test(nd.op || '')) throw new Error('bad block: ' + JSON.stringify(nd).slice(0, 60));
  const out = { op: nd.op, i: {}, f: {}, m: nd.op === 'control_stop' ? { tagName: 'mutation', children: [], hasnext: /other/.test(JSON.stringify(nd.f || {})) ? 'true' : 'false' } : undefined };
  for (const [k, v] of Object.entries(nd.i || {})) out.i[k] = Array.isArray(v) ? v.map(x => cleanNode(x, depth + 1)) : (v && typeof v === 'object') ? cleanNode(v, depth + 1) : v;
  for (const [k, v] of Object.entries(nd.f || {})) out.f[k] = v;
  return out;
}
function sanitize(p) {
  const out = { title: String(p.title || 'Project').slice(0, 40), replace: !!p.replace, vars: (p.vars || []).map(String).slice(0, 20), how: p.how || '', stage: [], sprites: [] };
  if (p.bg && p.bg.c1) out.bg = { c1: p.bg.c1, c2: p.bg.c2 || p.bg.c1, stars: p.bg.stars, ground: p.bg.ground, mid: p.bg.mid };
  const sc = list => (list || []).filter(Array.isArray).map(s => s.map(x => cleanNode(x)));
  out.stage = sc(p.stage);
  out.sprites = (p.sprites || []).slice(0, 10).map((s, i) => ({ key: String(s.key || 'Sprite' + (i + 1)).slice(0, 30), kind: ART[s.kind] ? s.kind : 'ball',
    color: /^#[0-9a-f]{6}$/i.test(s.color) ? s.color : '#4c97ff', label: s.label, x: +s.x || 0, y: +s.y || 0, size: +s.size || 100, hidden: !!s.hidden, scripts: sc(s.scripts) }));
  return out;
}
async function claudeThink(text, history) {
  const res = await fetch('https://api.anthropic.com/v1/messages', { method: 'POST',
    headers: { 'content-type': 'application/json', 'x-api-key': CFG.key, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
    body: JSON.stringify({ model: CFG.model, max_tokens: 8000, system: LLM_SYSTEM, messages: history.concat([{ role: 'user', content: text }]) }) });
  if (!res.ok) throw new Error('API ' + res.status + ': ' + (await res.text()).slice(0, 160));
  const data = await res.json(), raw = data.content.map(c => c.text || '').join('');
  const j = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));
  return { reply: j.reply, plan: j.plan ? sanitize(j.plan) : null, raw };
}

/* ══════════════════════════════════════════════════════════════════
   9. CHAT CONTROLLER + UI
   ══════════════════════════════════════════════════════════════════ */
const history = [];
const UNSUP = [[/\b(sounds?|music|noises?)\b/, 'sound effects or music'], [/\bpower-?ups?\b/, 'power-ups'], [/\bbosse?s?\b/, 'boss fights'],
  [/\b(multiplayer|online|network)\b/, 'online play'], [/\b(leaderboard|high ?scores?)\b/, 'saved high scores'], [/\b(3d|three d)\b/, '3D graphics']];
const unsupported = t => UNSUP.filter(([re]) => re.test(t.toLowerCase())).map(x => x[1]);
function describe(plan, u) {
  if (plan.current) return `Done — I added ${u.stats.scripts} script${u.stats.scripts === 1 ? '' : 's'} to your selected sprite${plan.did && plan.did.length ? ' so it ' + plan.did.join(', and ') : ''}. Click the green flag to try it.`;
  return `**${plan.title}** is built: ${u.stats.sprites} sprite${u.stats.sprites === 1 ? '' : 's'}, ${(plan.vars || []).length} variable${(plan.vars || []).length === 1 ? '' : 's'}, ${u.stats.scripts} scripts.\n\n${plan.how || ''}\n\nAnything I built earlier was replaced (say *also* or *too* if you want to keep it). Press the **green flag** (or type /run). Scripts are stacked in a column — right-click the code area and pick *Clean up Blocks* to tidy. Say *undo* to remove it.`;
}
async function handle(text, ui) {
  const t = text.trim(), s = t.toLowerCase();
  if (s === '/clear') { ui.clear(); return; }
  if (s === '/run' || /^(run|start|go|green flag|play it|test it)$/.test(s)) { const vm = findVM(); if (!vm) return ui.bot('No Scratch editor found.'); vm.greenFlag(); return ui.bot('Green flag clicked ▶'); }
  if (s === '/stop' || /^(stop|halt)$/.test(s)) { const vm = findVM(); if (vm) vm.stopAll(); return ui.bot('Stopped ■'); }
  if (/^\/?undo$/.test(s)) { const r = await undoLast(); return ui.bot(r ? `Undid **${r}**.` : 'Nothing to undo.'); }
  const km = t.match(/^\/key\s+(\S+)/i);
  if (km) { CFG.key = km[1]; CFG.brain = 'claude'; return ui.bot('Claude brain **on**. The key stays in memory only (gone when you reload). If the request fails I fall back to the local brain. Use **/brain local** to switch back.'); }
  const mm = t.match(/^\/model\s+(\S+)/i); if (mm) { CFG.model = mm[1]; return ui.bot('Model set to ' + CFG.model); }
  if (/^\/brain\s+local/i.test(t)) { CFG.brain = 'local'; return ui.bot('Local brain on.'); }
  if (/^\/brain\s+claude/i.test(t)) { if (!CFG.key) return ui.bot('Add a key first: /key sk-ant-…'); CFG.brain = 'claude'; return ui.bot('Claude brain on.'); }
  let out = null;
  if (CFG.brain === 'claude' && CFG.key) {
    try { out = await claudeThink(t, history); history.push({ role: 'user', content: t }, { role: 'assistant', content: out.raw }); if (history.length > 12) history.splice(0, 2); }
    catch (e) { ui.bot('Claude brain failed (' + e.message + '). Using the local brain for this one.'); }
  }
  if (!out) out = localThink(t);
  if (out.reply && !out.plan) return ui.bot(out.reply);
  if (!out.plan) return ui.bot('I had nothing to build for that.');
  if (out.reply) ui.bot(out.reply);
  if (/\b(also|too|as well|in addition|combine|another one|keep (the|my) (old|other|current))\b/i.test(t) && out.plan.replace) out.plan.replace = false;
  ui.status('Building…');
  const u = await build(out.plan);
  ui.bot(describe(out.plan, u));
  const miss = unsupported(t);
  if (miss.length && !(CFG.brain === 'claude' && CFG.key)) ui.bot(`I couldn't add **${miss.join(', ')}** with my built-in brain. Type **/key sk-ant-…** to let Claude design those, or ask me to adjust something I can do.`);
}


  const [lo, hi] = p.mode === 'mul' ? [2, 12] : [1, 12];
  const setAB = p.mode === 'sub' ? [set('a', rnd(10, 20)), set('b', rnd(1, 10))] : [set('a', rnd(lo, hi)), set('b', rnd(lo, hi))];
  const nm = { add: 'Addition', sub: 'Subtraction', mul: 'Multiplication' }[p.mode];
  return { title: nm + ' quiz', replace: true, vars: ['score', 'a', 'b'], bg: bgFor(p, 'forest'),
    sprites: [{ key: 'Teacher', kind: 'hero', color: p.color || '#9966ff', size: 160, x: 0, y: -30, scripts: [[

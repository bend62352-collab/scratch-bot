  return { title: 'Catch game', replace: true, vars: ['score', 'lives', 'speed'], bg: bgFor(p, 'sky'),
    sprites: [
      { key: 'Basket', kind: 'basket', color: p.color || '#ff9f40', x: 0, y: -140, scripts: [
        [flag(), set('score', 0), set('lives', lives), set('speed', sp), showVar('score'), showVar('lives'), goXY(0, -140), forever(setX(mouseX()))]] },
      { key: 'Faller', kind: fk, color: fc, x: 0, y: 170, hidden: true, scripts: [
        [flag(), hide(), wait(0.3), until(lt(V('lives'), 1), clone('_myself_'), wait(rnd(0.5, 1.1)))],
        [onClone(), goXY(rnd(-200, 200), 170), show(),

  const paddle = (key, color, x, up, down) => ({ key, kind: 'paddle', color, x, y: 0, scripts: [
    [flag(), goXY(x, 0), forever(iff(and(keyDown(up), lt(ypos(), 140)), chY(9)), iff(and(keyDown(down), gt(ypos(), -140)), chY(-9)))]] });
  return { title: 'Pong', replace: true, vars: ['P1', 'P2'], bg: bgFor(p, 'dark', { mid: 1 }),
    sprites: [
      paddle('Left', '#4c97ff', -215, 'w', 's'), paddle('Right', '#ff4d6d', 215, 'up arrow', 'down arrow'),
      { key: 'Ball', kind: 'ball', color: '#ffffff', size: 45, x: 0, y: 0, scripts: [[
        flag(), set('P1', 0), set('P2', 0), showVar('P1'), showVar('P2'), goXY(0, 0), point(rnd(50, 130)), wait(1),
        forever(move(sp),
          iff(touching('Left'), point(sub(0, dir())), move(10)),
          iff(touching('Right'), point(sub(0, dir())), move(10)),
          iff(lt(xpos(), -222), chg('P2', 1), goXY(0, 0), point(rnd(-130, -50)), wait(0.8)),
          iff(gt(xpos(), 222), chg('P1', 1), goXY(0, 0), point(rnd(50, 130)), wait(0.8)),
          iff(gt(V('P1'), 4), bcast('p1 wins')), iff(gt(V('P2'), 4), bcast('p2 wins')), bounce())]] },
      banner('P1Wins', 'P1 WINS!', 'p1 wins', '#4c97ff'), banner('P2Wins', 'P2 WINS!', 'p2 wins', '#ff4d6d')],
    how: 'Two players. Left paddle: W / S. Right paddle: ↑ / ↓. First to 5 points wins.' };

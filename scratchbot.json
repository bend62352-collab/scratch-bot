function parse(text) {
  const s = text.toLowerCase();
  const color = Object.keys(COLORS).find(c => new RegExp('\\b' + c + '\\b').test(s));
  const th = [['night|space|galaxy|dark', 'night'], ['ocean|sea|underwater', 'ocean'], ['forest|jungle|grass', 'forest'],
              ['desert|sand', 'desert'], ['sunset|dusk', 'sunset'], ['snow|winter|ice', 'snow']]
              .find(([re]) => new RegExp('\\b(' + re + ')\\b').test(s));
  const obj = [['apples?', 'apple'], ['stars?', 'star'], ['coins?|gold', 'coin'], ['balls?', 'ball']].find(([re]) => new RegExp('\\b(' + re + ')\\b').test(s));
  return {
    s, color: color && COLORS[color], theme: th && th[1], obj: obj && obj[1],
    lives: +(s.match(/(\d+)\s*lives?/) || [])[1] || 0,
    q: +(s.match(/(\d+)\s*(questions?|rounds?)/) || [])[1] || 5,
    speed: /\b(fast|quick|hard|insane|crazy|harder)\b/.test(s) ? 1.4 : /\b(slow|easy|chill|relaxed|easier)\b/.test(s) ? 0.7 : 1,
    bot: /\b(bots?|ai|computer|cpu|single ?player|1 ?player|one player|solo|against)\b/.test(s),
    menu: /\b(menu|ui|buttons?|levels?|select|choose|pick|difficult\w*)\b/.test(s) || new Set(s.match(/\b(easy|normal|medium|hard)\b/g) || []).size > 1,
    levelWords: (s.match(/\b(easy|normal|medium|hard)\b/g) || []).length,
    level: (() => { const w = s.match(/\b(easy|normal|medium|hard)\b/g) || []; return w.length === 1 ? { easy: 1, normal: 2, medium: 2, hard: 3 }[w[0]] : 0; })(),
    mode: /\b(times|multipl\w*)\b/.test(s) ? 'mul' : /\b(minus|subtract\w*|take away)\b/.test(s) ? 'sub' : 'add'
  };
}

